# ==============================================================================
# ConnectX Environment Configuration
# ==============================================================================

# Firebase Web App Configuration (Required for Live SMS Phone Authentication)
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin SDK Service Account (Required for backend token verification)
# Generate from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Path to the downloaded service account JSON file on your machine:
# Example: FIREBASE_SERVICE_ACCOUNT_JSON=C:\secure\firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Development OTP Mode
# When Firebase is not configured or DEV_OTP_MODE=true,
# the app allows quick local testing with dev OTP "123456".
DEV_OTP_MODE=false
